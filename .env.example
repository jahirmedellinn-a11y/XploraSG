# ==============================================================================
# VARIABLES DE ENTORNO - XPLORASG (RAÍZ / DOCKER COMPOSE)
# ==============================================================================
# Renombra este archivo a .env para el desarrollo local.
# Estas credenciales son de desarrollo. NO USAR EN PRODUCCIÓN.

# --- BASE DE DATOS (Contenedor local de PostgreSQL) ---
POSTGRES_USER=xplorasg_dev_user
POSTGRES_PASSWORD=xplorasg_dev_password_solo_desarrollo
POSTGRES_DB=xplorasg_db

# --- BACKEND ---
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
AUTH_MODE=dev
DEV_JWT_SECRET=xplorasg_dev_jwt_secret_temporal_123
CORS_ORIGINS=http://localhost:5173

# --- SUPABASE / FASE 4A ---
# Para la integración remota cambia AUTH_MODE a supabase y sustituye DATABASE_URL
# por la cadena copiada desde Connect en el Dashboard de Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos que todavía muestran la clave anon heredada.
SUPABASE_ANON_KEY=
# Solo para proyectos que todavía firman tokens con el secreto HS256 heredado.
# La validación preferida usa el JWKS público y no necesita este secreto.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Usada por la carga administrativa de fichas al bucket privado de revisión.
# No se utiliza para validar sesiones ni debe llevar prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- FRONTEND (variables públicas incorporadas por Vite) ---
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con la clave anon heredada.
VITE_SUPABASE_ANON_KEY=

# --- FASES POSTERIORES ---
OPEN_ROUTE_SERVICE_API_KEY=
AI_PROVIDER_API_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_MODEL=

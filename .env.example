# ==============================================================================
# VARIABLES DE ENTORNO - XPLORASG (RAÍZ / DOCKER COMPOSE)
# ==============================================================================
# Renombra este archivo a .env para el desarrollo local.
# Estas credenciales son de desarrollo. NO USAR EN PRODUCCIÓN.

# --- BASE DE DATOS (Contenedor local de PostgreSQL) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- BACKEND ---
PORT=3000
DATABASE_URL=
AUTH_MODE=dev
DEV_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# --- SUPABASE / FASE 4A ---
# Para la integración remota cambia AUTH_MODE a supabase y sustituye DATABASE_URL
# por la cadena copiada desde Connect en el Dashboard de Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos que todavía muestran la clave anon heredada.
SUPABASE_ANON_KEY=
# Solo para proyectos que todavía firman tokens con el secreto HS256 heredado.
# La validación preferida usa el JWKS público y no necesita este secreto.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Usada por la carga administrativa de fichas al bucket privado de revisión.
# No se utiliza para validar sesiones ni debe llevar prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- FRONTEND (variables públicas incorporadas por Vite) ---
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con la clave anon heredada.
VITE_SUPABASE_ANON_KEY=

# --- FASES POSTERIORES ---
OPEN_ROUTE_SERVICE_API_KEY=
AI_PROVIDER_API_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_MODEL=

# --- ASISTENTE CON IA (OPCIONAL) ---
# Sin estas claves el asistente usa su motor semántico local (catálogo + clima).
# OpenAI o compatible:
OPENAI_API_KEY=
OPENAI_MODEL=
# Anthropic (tiene prioridad si ambas están configuradas):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- PRODUCCIÓN ---
# NODE_ENV=production activa HSTS y desactiva /api/test y /api/db-test.
NODE_ENV=development
# Número de proxies HTTPS delante del backend (Render, Railway, Nginx...).
TRUST_PROXY=

# --- FRONTEND: RESERVAS Y SESIÓN ---
# WhatsApp de respaldo (52 + lada + número) cuando un servicio no tiene teléfono.
VITE_WHATSAPP_RESERVAS=
# Minutos de inactividad antes de cerrar la sesión automáticamente.
VITE_IDLE_TIMEOUT_MIN=15

